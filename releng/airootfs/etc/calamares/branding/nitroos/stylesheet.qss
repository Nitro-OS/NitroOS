QWidget {
    background-color: #121a12;
    color: #d4edda;
    font-family: "Inter", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 10px;
    selection-background-color: #4a9e4a;
    selection-color: #f0fff0;
}

QDialog, QMainWindow {
    background-color: #121a12;
}

QLabel {
    background-color: transparent;
    color: #d4edda;
    font-size: 10px;
}

QLabel:disabled {
    color: #3d5240;
}

QLabel#label_title,
QLabel#labelTitle,
QLabel#labelSubtitle {
    font-size: 15px;
    font-weight: 600;
    color: #e8f5e9;
    margin-bottom: 4px;
}
#sidebarApp {
    background-color: #0c1210;
    border-right: 1px solid #1a2a1a;
    min-width: 300px;
    max-width: 300px;
    padding: 16px 0;
}

#sidebarWidget,
#sidebarMenu {
    background-color: #0c1210;
}

#sidebarMenu::item {
    padding: 10px 20px 10px 24px;
    color: #8ab890;
    border-left: 3px solid transparent;
    margin: 1px 0;
}

#sidebarMenu::item:selected {
    background-color: #162816;
    color: #6dbf6d;
    font-weight: 600;
    border-left: 3px solid #6dbf6d;
}

#sidebarMenu::item:hover:!selected {
    background-color: #132013;
    color: #c8e6c9;
}

#debugButton,
#aboutButton {
    background-color: transparent;
    color: #4a7a4a;
    border: none;
    border-radius: 0;
    padding: 6px 16px;
    font-size: 10px;
    text-align: center;
}

#debugButton:hover,
#aboutButton:hover {
    color: #8ab890;
    background-color: #132013;
}

QPushButton {
    background-color: #1a2a1a;
    color: #c8e6c9;
    border: 1px solid #273d27;
    border-radius: 6px;
    padding: 6px 18px;
    font-size: 10px;
    font-weight: 500;
    min-height: 28px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #223322;
    border-color: #5aad5a;
    color: #e8f5e9;
}

QPushButton:pressed {
    background-color: #2b3f2b;
    border-color: #5aad5a;
}

QPushButton:disabled {
    background-color: #131d13;
    color: #2e4030;
    border-color: #1a2a1a;
}

QPushButton:default {
    background-color: #1e3a1e;
    border: 1px solid #5aad5a;
    color: #c8e6c9;
}

QPushButton:default:hover {
    background-color: #5aad5a;
    color: #071207;
}

QPushButton:default:pressed {
    background-color: #4a9a4a;
}

QToolButton {
    background-color: #1a2a1a;
    color: #c8e6c9;
    border: 1px solid #273d27;
    border-radius: 5px;
    padding: 4px 8px;
    font-size: 10px;
}

QToolButton:hover {
    background-color: #223322;
    border-color: #5aad5a;
}
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: #0c1210;
    color: #d4edda;
    border: 1px solid #253525;
    border-radius: 5px;
    padding: 5px 9px;
    font-size: 10px;
    min-height: 26px;
    selection-background-color: #4a9e4a;
    selection-color: #f0fff0;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #5aad5a;
    background-color: #0e1a0e;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QSpinBox:disabled {
    background-color: #0a120a;
    color: #2d3e2d;
    border-color: #1a2a1a;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background-color: #1a2a1a;
    border: none;
    width: 18px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #223322;
}
QComboBox {
    background-color: #0c1210;
    color: #d4edda;
    border: 1px solid #253525;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 10px;
    min-height: 26px;
}

QComboBox:hover {
    border-color: #5aad5a;
}

QComboBox:focus {
    border-color: #5aad5a;
}

QComboBox:disabled {
    background-color: #0a120a;
    color: #2d3e2d;
    border-color: #1a2a1a;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #253525;
    border-radius: 0 5px 5px 0;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #0c1210;
    color: #d4edda;
    border: 1px solid #253525;
    border-radius: 4px;
    selection-background-color: #1e3a1e;
    selection-color: #6dbf6d;
    padding: 2px;
    outline: none;
}

QCheckBox,
QRadioButton {
    spacing: 8px;
    color: #c8e6c9;
    font-size: 10px;
    background-color: transparent;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #2d3e2d;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid #2e4030;
    background-color: #0c1210;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #5aad5a;
}

QCheckBox::indicator:checked {
    background-color: #5aad5a;
    border-color: #5aad5a;
}

QRadioButton::indicator:checked {
    background-color: #5aad5a;
    border-color: #5aad5a;
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    background-color: #0a120a;
    border-color: #1a2a1a;
}

QTreeView,
QListView,
QTableView {
    background-color: #0c1210;
    color: #d4edda;
    border: 1px solid #1e2e1e;
    border-radius: 6px;
    padding: 2px;
    outline: none;
    font-size: 10px;
    gridline-color: #1a2a1a;
    alternate-background-color: #0e160e;
}

QTreeView::item,
QListView::item,
QTableView::item {
    padding: 5px 6px;
    border-radius: 4px;
    min-height: 22px;
}

QTreeView::item:hover,
QListView::item:hover,
QTableView::item:hover {
    background-color: #132013;
    color: #e8f5e9;
}

QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected {
    background-color: #1e3a1e;
    color: #6dbf6d;
}

QTreeView::item:selected:!active,
QListView::item:selected:!active,
QTableView::item:selected:!active {
    background-color: #192e19;
    color: #6dbf6d;
}

QTreeView::branch {
    background-color: transparent;
}

QHeaderView::section {
    background-color: #101a10;
    color: #8ab890;
    padding: 5px 8px;
    border: none;
    border-right: 1px solid #1e2e1e;
    border-bottom: 1px solid #1e2e1e;
    font-size: 10px;
    font-weight: 600;
}

QHeaderView::section:first {
    border-left: none;
}
QProgressBar {
    background-color: #0c1210;
    border: 1px solid #1e2e1e;
    border-radius: 5px;
    text-align: center;
    color: #c8e6c9;
    font-size: 10px;
    font-weight: 500;
    min-height: 16px;
    max-height: 16px;
}

QProgressBar::chunk {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #3a8c3a,
        stop:1 #5aad5a
    );
    border-radius: 4px;
    margin: 1px;
}
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #253525;
    min-height: 30px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #5aad5a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #253525;
    min-width: 30px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: #5aad5a;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

QGroupBox {
    border: 1px solid #1e2e1e;
    border-radius: 6px;
    margin-top: 16px;
    padding-top: 12px;
    padding-left: 8px;
    font-size: 10px;
    font-weight: 600;
    color: #8ab890;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #6dbf6d;
    background-color: #121a12;
}
QTabWidget::pane {
    border: 1px solid #1e2e1e;
    border-radius: 5px;
    background-color: #121a12;
    top: -1px;
}

QTabBar::tab {
    background-color: #0c1210;
    color: #8ab890;
    border: 1px solid #1e2e1e;
    border-bottom: none;
    padding: 6px 14px;
    font-size: 10px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    margin-right: 2px;
    min-width: 60px;
}

QTabBar::tab:selected {
    background-color: #162816;
    color: #6dbf6d;
    border-color: #2e4030;
    border-bottom-color: #162816;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #132013;
    color: #c8e6c9;
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #1e2e1e;
    background-color: #1e2e1e;
    max-height: 1px;
    border: none;
}

QToolTip {
    background-color: #0c1210;
    color: #c8e6c9;
    border: 1px solid #2e4030;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 10px;
}
